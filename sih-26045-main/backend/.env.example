# IP-SAKTI backend configuration.
# Copy to .env  (cp backend/.env.example backend/.env)  and fill in the values.
# Translation credentials are required for non-English translation.

# --- LLM (answers, reasoning, fact extraction) ---
# Option 1: Local Ollama (default for local offline development)
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
LLM_NUM_CTX=4096
LLM_TIMEOUT=300

# Option 2: 100% FREE Online Deployment with Google Gemini (Recommended - 1,000,000 TPM limit)
# Get a free API key at https://aistudio.google.com/apikey (No credit card needed)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=AQ.your_gemini_api_key_here
# LLM_MODEL=gemini-flash-lite-latest

# --- CORS & Web Deployment ---
# For online deployment, specify allowed origins or leave as *
CORS_ORIGINS=*

# --- Translation (Bhashini) ---
# Obtain these values from the Bhashini/ULCA portal. Do not commit real secrets.
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
# Leave the inference values blank to use Bhashini pipeline discovery.
BHASHINI_INFERENCE_URL=
BHASHINI_INFERENCE_AUTH_TOKEN=
BHASHINI_INFERENCE_AUTH_HEADER=Authorization
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_SOURCE_LANGUAGE=en
BHASHINI_TIMEOUT=60
BHASHINI_MAX_RETRIES=3
BHASHINI_BATCH_SIZE=32

# --- Auth & Database ---
# Change this to any long random string before a real deployment.
SECRET_KEY=change-me-to-a-long-random-value
# Local development default:
DATABASE_URL=sqlite:///./app.db
# For Production with Supabase PostgreSQL (persistent users & sessions):
# Use Supabase Session Pooler (port 5432) for IPv4 compatibility on Render:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# How long a login stays valid (minutes). Default 8 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Email (OTP verification) ---
# Signup/login send a 6-digit code to the user's email. Set ALL FOUR fields
# below for real email delivery. For Gmail: turn on 2-Step Verification, then
# create an App Password (Google Account > Security > App passwords) and paste
# the 16-character value (no spaces) as MAIL_PASSWORD.
#
# IF THESE ARE LEFT BLANK (demo / zero-setup mode): no email is sent — instead
# the OTP is printed in the backend logs AND shown on the verification screen so
# signup still works with no mail account. Do NOT ship blank mail settings to a
# real deployment: it exposes the code over the API.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Note: RAG retrieval embeddings use the local sentence-transformers model
# all-MiniLM-L6-v2 (no API key needed); do not change it or retrieval will
# mismatch the ingested TKDL corpus vectors.
