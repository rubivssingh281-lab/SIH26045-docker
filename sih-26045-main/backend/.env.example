# IP-SAKTI backend configuration.
# Copy to .env and adjust as needed. Defaults already use the LOCAL phi3 model via Ollama.

# --- LLM (fact extraction + Sahayak assistant) ---
# Default provider is local Ollama running phi3. Requires `ollama serve` and `ollama pull phi3`.
LLM_PROVIDER=ollama
LLM_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434
# phi3 defaults to a 128k context window; cap the KV cache so it fits in modest RAM.
LLM_NUM_CTX=4096
LLM_TIMEOUT=300

# To use OpenAI instead of local phi3, set:
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o-mini
#   OPENAI_API_KEY=sk-...

# Optional: route ONLY the assistant chatbot through a different model/tag.
# ASSISTANT_LLM_MODEL=mistral:7b-instruct-q5_K_M

# --- Auth / DB ---
SECRET_KEY=change-me-before-deployment
DATABASE_URL=sqlite:///./app.db

# --- Email (OTP verification) ---
# Signup/login OTPs are emailed to the user. Set all three for email to work.
# For Gmail: enable 2-Step Verification, then create an App Password
# (Google Account > Security > App passwords) and use that 16-char value below.
# MAIL_USERNAME=youraddress@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM=youraddress@gmail.com
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# If these are left blank, OTP emails are skipped (signup will not receive a code).

# Note: RAG retrieval embeddings use the local sentence-transformers model
# all-MiniLM-L6-v2 (no API key needed); do not change it or retrieval will
# mismatch the ingested TKDL corpus vectors.
